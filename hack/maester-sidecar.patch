 func (fo *FilesOperator) updateOrCreateRulesFile(ctx context.Context, data string) error {
-	var f *os.File
-	f, err := os.Create(fo.RulesFilePath)
+	// write a temp file next to the rules file, then rename it over: a reader
+	// (Oathkeeper's file watcher) never sees a truncated or partial file
+	tmp, err := os.CreateTemp(filepath.Dir(fo.RulesFilePath), "."+filepath.Base(fo.RulesFilePath)+".*")
 	if err != nil {
 		fo.Log.Error(err, "error while creating config file")
 		return err
 	}
-	defer f.Close()
-	w := bufio.NewWriter(f)
-	byteCount, err := w.WriteString(data)
-	fo.Log.Info(fmt.Sprintf("writing %d bytes of data into %s", byteCount, fo.RulesFilePath))
-	w.Flush()
+	defer os.Remove(tmp.Name())
+	byteCount, err := tmp.WriteString(data)
+	if err == nil {
+		err = tmp.Chmod(0o644)
+	}
+	if cerr := tmp.Close(); err == nil {
+		err = cerr
+	}
+	if err == nil {
+		err = os.Rename(tmp.Name(), fo.RulesFilePath)
+	}
 	if err != nil {
 		fo.Log.Error(err, "error while writing to file")
 		return err
 	}
+	fo.Log.Info(fmt.Sprintf("writing %d bytes of data into %s", byteCount, fo.RulesFilePath))
 	return nil
 }
 
